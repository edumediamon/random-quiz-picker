# ==============================================================================
# Google Cloud Platform (GCP) 연동 설정 예제 파일 (.env)
# 
# 사용 방법:
# 1. 이 파일을 복사하여 '.env' 파일로 이름을 변경합니다.
# 2. 발급받으신 Google OAuth 2.0 Client ID와 API Key를 아래 항목에 입력합니다.
# 3. 로컬 서버(npm start 또는 node server.js)를 실행하면 자동으로 읽어 웹 화면에 적용됩니다.
# ==============================================================================

# Google Cloud 콘솔 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 승인된 JavaScript 원본에 http://localhost:3000 이 등록되어 있어야 합니다.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Google Cloud 콘솔 > 사용자 인증 정보 > API 키
# Google Picker API 및 Google Drive API가 활성화되어 있어야 합니다.
GOOGLE_API_KEY=AIzaSyYourGoogleCloudApiKey
